            "required_inputs": [
              "network.kind=inline",
              "study.options.bus/type/rf",
              "xdpp_pu on machines",
              "powerfactory_method / powerfactory_voltage_factor (Method C requires the source factor)",
              "r0_ohm_per_km/x0_ohm_per_km + sk1_mva for slg/llg"
            ],
            "gate": "physics-audit fault section; IEC method/voltage-factor fail-closed (see PFD Method C blocking)"
