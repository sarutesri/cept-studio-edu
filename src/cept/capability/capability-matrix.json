{
  "schema_version": 1,
  "representations": ["inline", "dss_file", "builtin"],
  "header": {
    "note": "Single machine-readable source of truth for CEPT study capability. A (study_type, engine, representation_family) cell is SUPPORTED/BOUNDED/DEMONSTRATOR/BLOCKED; a BLOCKED cell MUST carry a named 'reason'. The '*', representation family is a wildcard meaning 'all representations'. Reserved study types (economic_dispatch, unit_commitment) are BLOCKED for every engine with a named reason; they are NEVER silently converted to load_flow.",
    "status_meaning": {
      "supported": "Reviewed adapter + audit + benchmark exist; solver-returned quantities are trustworthy.",
      "bounded": "Supported for a narrow, declared subset; anything outside the subset fails closed.",
      "demonstrator": "Runs and is solver-valid, but is demonstrator-capped (no project validation claim).",
      "blocked": "Not supported for this (study_type, engine, representation); reason is mandatory."
    }
  },
  "reserved_study_types": {
    "economic_dispatch": {
      "status": "blocked",
      "reason": "Economic dispatch is reserved in CEPT: no adapter, physics-audit section, or benchmark exists for it. It is never silently converted to load_flow. External dispatch/optimization workflows must invoke `cept study run` as a sub-solver from workspace/<slug>/local/; CEPT never becomes the optimizer.",
      "gate": "Gate blocking a Case whose study.type is 'economic_dispatch' before any solver connection."
    },
    "unit_commitment": {
      "status": "blocked",
      "reason": "Unit commitment is reserved in CEPT: no adapter, physics-audit section, or benchmark exists for it. It is never silently converted to load_flow. External optimization workflows must invoke `cept study run` as a sub-solver from workspace/<slug>/local/; CEPT never becomes the optimizer.",
      "gate": "Gate blocking a Case whose study.type is 'unit_commitment' before any solver connection."
    }
  },
  "study_types": {
    "load_flow": {
      "engines": {
        "opendss": {
          "*": {
            "status": "supported",
            "fidelity": "steady_state",
            "quantities": {
              "supported": [
                "load_flow.converged",
                "load_flow.iterations",
                "bus_voltages[].v_pu",
                "bus_voltages[].v_angle_deg",
                "bus_voltages[].v_kv_ln",
                "branch_flows[].p_kw",
                "branch_flows[].q_kvar",
                "branch_flows[].losses_kw",
                "branch_flows[].loading_pct",
                "total_load_kw",
                "total_load_kvar",
                "total_loss_kw",
                "total_loss_kvar",
                "source_p_kw",
                "source_q_kvar",
                "der_outputs[].p_kw",
                "der_outputs[].q_kvar"
              ],
              "unsupported": []
            },
            "required_inputs": [
              "network.kind",
              "frequency_hz",
              "buses[].kv",
              "loads[].kw",
              "loads[].pf",
              "loads[].bus",
              "generators or external_grids (at least one in-service source)",
              "lines[].r1_ohm_per_km/x1_ohm_per_km/b1_us_per_km/length_km (inline)",
              "or network.path (dss_file) or network.name (builtin)"
            ],
            "gate": "physics-audit load_flow section (finite + converged + fingerprint identity); fidelity read-back gate before Solve()"
          }
        },
        "powerfactory": {
        "inline": {
          "status": "supported",
          "fidelity": "steady_state",
          "quantities": {
            "supported": [
              "load_flow.converged",
              "load_flow.iterations",
              "bus_voltages[].v_pu",
              "bus_voltages[].v_angle_deg",
              "bus_voltages[].v_kv_ln",
              "branch_flows[].p_kw",
              "branch_flows[].q_kvar",
              "branch_flows[].losses_kw",
              "branch_flows[].loading_pct",
              "total_load_kw",
              "total_load_kvar",
              "total_loss_kw",
              "total_loss_kvar",
              "source_p_kw",
              "source_q_kvar"
            ],
            "unsupported": []
          },
          "required_inputs": [
            "network.kind=inline (PowerFactory requires inline networks)",
            "frequency_hz",
            "buses[].kv",
            "loads[].kw/pf/bus",
            "generators or external_grids (in-service source)",
            "lines[].r1_ohm_per_km/x1_ohm_per_km/b1_us_per_km/length_km",
            "or total_parameters (source-bound R/X/B)"
          ],
          "gate": "physics-audit load_flow section; fidelity read-back gate before ComLdf"
        },
        "dss_file": {
          "status": "blocked",
          "reason": "PowerFactory requires network.kind='inline'; a dss_file feeder is OpenDSS-only.",
          "gate": "Case._check_engine_compat already blocks engine=powerfactory with network.kind != inline."
        },
        "builtin": {
          "status": "blocked",
          "reason": "PowerFactory requires network.kind='inline'; a builtin feeder is OpenDSS-only.",
          "gate": "Case._check_engine_compat already blocks engine=powerfactory with network.kind != inline."
        }
      }
      }
    },
    "unbalanced_load_flow": {
