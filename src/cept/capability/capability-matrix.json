              "r0_ohm_per_km/x0_ohm_per_km + sk1_mva for slg/llg"
            ],
            "gate": "physics-audit fault section (positive finite current, fault_type membership, during-fault voltages, IEC 60909 voltage factor); xdpp_pu research gate"
          }
        },
        "powerfactory": {
          "inline": {
            "status": "demonstrator",
            "fidelity": "steady_state",
            "quantities": {
              "supported": [
                "fault.bus",
                "fault.fault_type",
                "fault.total_fault_current_a",
                "fault.currents[].i_amp",
