          "dss_file": {
            "status": "blocked",
            "reason": "PowerFactory requires network.kind='inline'.",
            "gate": "Case._check_engine_compat"
          },
          "builtin": {
            "status": "blocked",
            "reason": "PowerFactory requires network.kind='inline'.",
            "gate": "Case._check_engine_compat"
          }
        }
      }
    },
