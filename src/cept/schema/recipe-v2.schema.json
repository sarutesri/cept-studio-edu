{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cept.local/schema/workflow-recipe-v2.schema.json",
  "title": "CEPT workflow recipe (workflow-recipe-v2)",
  "description": "The recipe document a person writes. Owners, outputs, success transitions and parameter defaults come from the operation registry and are not written here. Semantic rules this schema cannot express (a step names only parameters its operation takes; on_failure names a declared step id; includes are one level) are enforced by `cept run --recipe`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "steps",
    "must_produce"
  ],
  "properties": {
    "schema": {
      "const": "workflow-recipe-v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "default": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "needs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "Shorthand: a string input with this default."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "file",
                  "directory",
                  "string",
                  "integer",
                  "boolean"
                ],
                "default": "string"
              },
              "default": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ]
              },
              "optional": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            },
            "not": {
              "required": [
                "default",
                "optional"
              ]
            }
          }
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "description": "<operation> [input names]",
            "pattern": "^(?:assemble\\.notebook|audit\\.artifacts|audit\\.perunit|audit\\.physics|audit\\.release|check\\.case|compare\\.runs|render\\.report|run\\.study|serve\\.report|verify\\.study|write\\.receipt)(?: +[A-Za-z_][A-Za-z0-9_]*)*$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "assemble.notebook",
                  "audit.artifacts",
                  "audit.perunit",
                  "audit.physics",
                  "audit.release",
                  "check.case",
                  "compare.runs",
                  "render.report",
                  "run.study",
                  "serve.report",
                  "verify.study",
                  "write.receipt"
                ]
              },
              "needs": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    }
                  }
                ]
              },
              "on_failure": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "include"
            ],
            "properties": {
              "include": {
                "type": "string",
                "pattern": "^[^/\\\\]+\\.(?:ya?ml|json)$"
              },
              "needs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "reason": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "must_produce": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
