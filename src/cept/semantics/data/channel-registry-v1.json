{
  "schema": "cept-channel-registry-v1",
  "review_note": "Every entry is a reviewed source-to-canonical binding. A raw channel that is absent from this file has no proven semantics: it must be reported as unreviewed and excluded from any parity denominator. Never add an entry to make two numbers agree.",
  "canonical_quantities": {
    "voltage_magnitude": "Terminal/bus voltage magnitude",
    "voltage_angle": "Bus voltage phase angle",
    "frequency": "Electrical frequency",
    "rotor_angle": "Machine rotor angle in the source's own reference",
    "relative_rotor_angle": "Machine rotor angle relative to a reference machine",
    "rotor_speed": "Machine rotor speed",
    "active_power": "Active power flow",
    "reactive_power": "Reactive power flow",
    "electrical_power": "Machine electrical power on the machine base",
    "turbine_power": "Machine mechanical/turbine power on the machine base",
    "current": "Current magnitude",
    "rotor_position_d": "Rotor position on the d-axis, referred to the reference bus voltage (s:phi)",
    "rotor_position_x": "Rotor position reported by the machine state x (s:xphi); equivalence with rotor_position_d is not proven",
    "excitation_voltage": "Machine field/excitation voltage",
    "electrical_torque": "Machine electrical torque",
    "mechanical_torque": "Machine mechanical torque",
    "external_rotor_angle": "Rotor angle measured outside the machine",
    "internal_rotor_angle": "Rotor angle measured inside the machine"
  },
