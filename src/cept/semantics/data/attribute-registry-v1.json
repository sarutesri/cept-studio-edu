{
  "schema": "cept-attribute-registry-v1",
  "review_note": "PowerFactory exposes ~150-320 attributes per element class. Most are graphics, reliability statistics, or values PowerFactory itself calculates -- not inputs that describe the network. This file says which of them matter. Pattern rules disposition whole families at once so review stays tractable; an attribute matched by no rule and captured by no collector is reported as 'unreviewed' on every ingest, which is how a genuinely meaningful input stops being invisible. Adding a pattern is a claim that nothing in that family changes a study result.",
  "enumeration": {
    "method": "dir(obj) filtered by obj.HasAttribute(name)",
    "verified_on": "PowerFactory 2023 SP1; HasAttribute returns 1 for 'dline' and 0 for 'GetAttribute', which is what separates data from methods"
  },
  "not_needed_patterns": [
    {
      "pattern": "^c_",
      "reason": "PowerFactory-calculated cache, not a source input"
    },
    {
      "pattern": "^cdisp",
      "reason": "single-line-diagram display position"
    },
    {
      "pattern": "^cpHead|^cpArea|^cpZone|^cpSite|^cpSubstat|^cpGrid|^cpBranch|^cpFeed|^cpOwner|^cpOperator",
      "reason": "container back-reference; topology is carried by the element's own terminals"
    },
    {
      "pattern": "^Box|^Icon|^Marker|^Label|^Text|^Font|^Colour|^Color",
      "reason": "diagram rendering"
    },
    {
      "pattern": "^GPS",
      "reason": "geographic coordinate, not an electrical input"
    },
    {
      "pattern": "^FO[A-Z]|^FOR[0-9]|^CCEar|^Rep[A-Z]|^Mu[A-Z]|^p_rel|^stochastic",
      "reason": "reliability failure/repair statistics; no deterministic study consumes them"
    },
    {
      "pattern": "^appr_|^chr_name|^doc_id|^for_name|^dat_src|^root_id|^tid_|^oid_|^gnrl_modif|^desc$|^cimRdfId",
      "reason": "bookkeeping/provenance metadata inside PowerFactory"
    },
    {
      "pattern": "^dataExt",
      "reason": "user-defined extension blob"
    },
    {
      "pattern": "^i_cscan|^i_scan|^cScan",
      "reason": "frequency-scan bookkeeping"
    },
    {
      "pattern": "^Ice|^Wind[A-Z]|^Temper|^Tmax|^Tmin|^Tload|^Ambient",
      "reason": "thermal/weather rating inputs; CEPT compares electrical results, not thermal ratings"
    },
    {
      "pattern": "^NrCust|^iInterrupt|^Anlge|^AccessTime|^outage",
      "reason": "outage/customer statistics used by reliability studies only"
    },
    {
      "pattern": "^i_hmea|^i_pmea|^pMeas|^pQmea",
      "reason": "measurement wiring, not a network input"
    },
    {
      "pattern": "^c[A-Z]|^ci[A-Z]",
      "reason": "PowerFactory-derived display/state value (cDisplayName, ciEnergized), not a source input"
    },
    {
      "pattern": "_a$|_a_|^coslini[rst]?_a",
      "reason": "per-phase 'actual' value derived from the balanced input"
    },
    {
      "pattern": "^Inom|^Irated|^InomPre|^Imax|^Ilim",
      "reason": "current rating derived from the element type"
    },
    {
      "pattern": "^T(a[0-9]|op|cold|hot|inrush|dc)$|^Top$|^Tmax|^depSmooth",
      "reason": "thermal/saturation timing input; CEPT compares electrical results"
    },
    {
      "pattern": "^T(clear|prot|switch)$",
      "reason": "protection timing; no CEPT study consumes it (a protection study would)"
    },
    {
      "pattern": "_uc$|_ucPU$|^P_(max|min)$|^Pngrel$|^Pnom$|^Pctrl$",
      "reason": "unit-commitment/dispatch limit; not consumed by load flow, fault or RMS"
    },
    {
      "pattern": "^(Z|R|X|B|G)[0-9]?_tmax$|^ReRl$|^XeXl$|^a[0-9]?dc$|^Z[0-9]$",
      "reason": "impedance restated in a derived form; the primary r/x/b/c inputs are captured"
    },
    {
      "pattern": "^Strat$|^cBasedOn$|^fSCDF$|^Ikd$|^J$|^cTdc$",
      "reason": "reviewed as not consumed by any CEPT study path"
    },
    {
      "pattern": "^commissionDate$|^NodeName$|^Electrodes$|^fold_id$|^gnrl_modby$|^ansiclass$|^aohl_$|^cohl_$|^iopt_(cnd|inp|inpshc)$",
      "reason": "source bookkeeping or construction detail with no electrical effect on CEPT's studies"
    },
    {
      "pattern": "^i(Limb|tratioadpt|trd[lr])|^ksat$|^lline$|^alpha$|^InomAir$",
      "reason": "construction/saturation detail not used by the balanced representation"
    },
    {
      "pattern": "^Irze$|^iNeutInter$|^Con[12]$|^ctrl_type$",
      "reason": "neutral/earthing wiring detail not represented in the balanced Case"
    },
    {
      "pattern": "^loc_name$|^pid_$|^for_name$",
      "reason": "object identifier; carried as the element name"
    },
    {
      "pattern": "^allow[A-Z]|^cnt[A-Z]|^availFactor$|^Ptolerance|^Vtolerance",
      "reason": "contingency-analysis setting; CEPT does not run PowerFactory's contingency module"
    },
    {
      "pattern": "^dbg_",
      "reason": "PowerFactory debug switch"
    },
    {
      "pattern": "^cmeth|^cnm_|^cshcloc$|^cfshcloc$|^cq_|^cpower$|^cgnd$|^ctag|^cosgini$",
      "reason": "PowerFactory-derived value, not a source input"
    },
    {
      "pattern": "[Cc]ost|^shed|^dispatch$|^beta$|^aCategory$|^coldStart|^QtargetRPR$|^iOPFC|^iPriority$|^ivpriority$|^i_opf",
      "reason": "optimal-power-flow / market input; no CEPT study path consumes it"
    },
    {
      "pattern": "^vstep|^smoothf|^strnfc$|^pict1$|^pitt1$|^pT$|^drawInrush$|^iinrush$|^ducts$|^armTyp$|^mlei$|^rtemp$|^tmax$|^rline_tmax$",
      "reason": "construction/regulation detail with no effect on the balanced electrical solution"
    },
    {
      "pattern": "Sbasepu$|^bSbasepu$|^rtox|^xtor$|^ccosphi$",
      "reason": "impedance restated on a different base; the primary input is captured"
    },
    {
      "pattern": "^ddroop$|^i_speedVar$|^iner_inp$|^hpn$|^nslty$",
      "reason": "machine detail not represented by the reviewed single-mass model"
    },
    {
      "pattern": "^f(max|min|tau)|^iterVF|^if_depth$|^icond$|^iopt_(dir|ord)$|^k0$|^ka0$|^Unom$",
      "reason": "frequency-dependent / EMT line-model input; CEPT's reviewed line model is the lumped RMS representation"
    },
    {
      "pattern": "^is[A-Z0-9]|^i_uoptCont|^isCtrl|^genShiftKey$|^gratio$|^drawStall$|^drawInr$|^iHmcType$|^ignd$|^efd|^ifd|^efficiency",
      "reason": "OPF/placement/excitation-base setting not consumed by CEPT's load-flow, fault or RMS paths"
    },
    {
      "pattern": "^imldc|^maxload$|^ntnum$|^cpCtrlNode|^i_(hv|lv)con$",
      "reason": "tap line-drop-compensation and winding-connection restatement; the vector group is captured from the transformer type"
    },
    {
      "pattern": "^xtormin$|^zonefact$|^slipmin$|^smoothFac$",
      "reason": "reviewed as not consumed by any CEPT study path"
    },
    {
      "pattern": "^soil|^solar_rad$|^temp_env$|^mediumTemp$|^thick_d$|^trays$|^occupCoeff$|^thetaX$|^txt_typ$|^qurs_A$|^shMat$|^loadfactor$",
      "reason": "cable-laying / thermal-environment input; affects rating, not the electrical solution CEPT compares"
    },
    {
      "pattern": "^maxErrVF|^polesVF|^tolBode$|^stMargin|^maxResPole|^minResTrain|^useDCcorr$|^meth(_bs|_nfc|_nfcmv)?$",
      "reason": "vector-fitting / frequency-domain model-order setting used by EMT line fitting"
    },
    {
      "pattern": "^k[az][0-9]$|^kz[0-9]$|^phik0$|^phiz[0-9]$|^rearth$|^ktrto$",
      "reason": "earth-return / zero-sequence coupling detail not represented in the balanced line model"
    },
    {
      "pattern": "^limRamp|^numBreakpointsCostOp$|^polyDegree$|^pCharYr|^scalingFacSoftConstr",
      "reason": "ramping / cost-curve input for optimisation, not consumed by CEPT"
    },
    {
      "pattern": "^lambda$|^mean$|^variance$|^rf_st$|^mdm(ex|lp)$|^pmaxratf$|^ratfac$|^speed_th$|^tags?$",
      "reason": "stochastic or machine bookkeeping value reviewed as not consumed by CEPT"
    },
    {
      "pattern": "^pStoch$|^pTypStoch$|^iperfect$|^iRestore$|^reclAttempts$|^cpRelays$",
      "reason": "reliability/restoration wiring; consumed by PowerFactory's reliability module, not by CEPT"
    },
    {
      "pattern": "^cpBay$|^cpBusbar$|^pZone$|^iSection$|^cnm$",
      "reason": "substation-layout back-reference; topology is carried by the element's own terminals"
    },
    {
      "pattern": "^condMat$|^tmat$|^coldloadtab|^ifrqft$|^mTaps$|^nntapabs$|^cloddy$|^loddy$",
      "reason": "material/table lookup or absolute-tap restatement with no effect on the balanced solution"
    }
  ],
